// Variable to store the Y position of the scrollbar knob
int knobY = 0;

void setup(void) {
  pinMode(BUTTON1, INPUT_PULLUP);
  pinMode(BUTTON2, INPUT_PULLUP);
  pinMode(BUTTON3, INPUT_PULLUP);
  u8g2.begin();
}

void loop(void) {
  // --- Check for Button Presses ---
  // If button 1 is pressed (LOW since it's INPUT_PULLUP), move knob down
  if (digitalRead(BUTTON1) == LOW) {
    knobY++;
  }
  // If button 2 is pressed, move knob up
  if (digitalRead(BUTTON2) == LOW) {
    knobY--;
  }

  // --- Constrain Knob Position ---
  // Ensure knobY doesn't go above the top limit (0)
  if (knobY < 0) {
    knobY = 0;
  }
  // Ensure knobY doesn't go below the bottom limit (24)
  if (knobY > 24) {
    knobY = 24;
  }

  // --- Redraw the entire screen ---
  u8g2.clearBuffer();
  u8g2.setBitmapMode(1); // Set transparent mode for overlapping bitmaps

  // Draw all the static background elements
  u8g2.drawXBM(0, 0, 128, 32, epd_bitmap_allArray[0]); // item_outline
  
  // Conditionally draw the Up arrow (hide if knob is at the top)
  if (knobY > 0) {
    u8g2.drawXBM(54, 0, 16, 8, epd_bitmap_allArray[11]); // up_arrow
  }
  
  // Conditionally draw the Down arrow (hide if knob is at the bottom)
  if (knobY < 24) {
    u8g2.drawXBM(54, 24, 16, 8, epd_bitmap_allArray[12]); // down_arrow
  }
  
  u8g2.drawXBM(120, 0, 8, 32, epd_bitmap_allArray[1]); // scroll_bar
  u8g2.drawXBM(4, 8, 16, 16, epd_bitmap_allArray[4]); // track_shot_icon

  // Draw the knob at its current 'knobY' position
  u8g2.drawXBM(120, knobY, 8, 8, epd_bitmap_allArray[2]); // scroll_bar_knob

  // Draw the text
  u8g2.setFont(u8g2_font_7x14B_tf);
  u8g2.drawStr(23, 20, "Track Shot");

  // Send the completed drawing to the display
  u8g2.sendBuffer();

  // Add a small delay for debouncing, so one press doesn't register many times
  delay(50);
}